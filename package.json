{
  "name": "lightui",
  "private": true,
  "workspaces": [
    "products/lab",
    "products/genui",
    "studies/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @lightui/lab",
    "dev:study": "npm run dev -w @lightui/intent-cascade",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run catalog:check && npm run test --workspaces --if-present",
    "typecheck": "npm run catalog:check && npm run typecheck --workspaces --if-present",
    "catalog": "node scripts/sync-catalog.mjs",
    "catalog:check": "node scripts/sync-catalog.mjs --check"
  },
  "engines": {
    "node": ">=20"
  }
}
