{
  "name": "@lightui/genui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Generative UI components, registry, and the versioned agent contract",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "check:boundaries": "tsx src/check-workspace-boundaries.ts",
    "typecheck": "tsc --noEmit --pretty false && npm run check:boundaries",
    "test": "tsx --test src/boundaries.test.ts src/contract.test.ts src/protocol.test.ts",
    "build": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  }
}
